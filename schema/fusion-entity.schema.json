{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearglassinc.com/schema/aurora-fusion-entity.json",
  "title": "AURORA Fusion Entity",
  "type": "object",
  "required": ["id", "type", "lat", "lon", "ts", "sources", "confidence", "classification"],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "type": {
      "type": "string",
      "enum": ["aircraft", "vessel", "seismic", "fire", "facility", "satellite", "cyber", "event", "alert"]
    },
    "name": { "type": "string" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "alt_m": { "type": "number" },
    "heading": { "type": "number", "minimum": 0, "maximum": 360 },
    "speed_mps": { "type": "number", "minimum": 0 },
    "ts": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "retrieved": { "type": "string", "format": "date-time" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification": { "type": "string", "const": "UNCLASSIFIED//PUBLIC" },
    "identity": {
      "type": "object",
      "properties": {
        "icao24": { "type": "string" },
        "callsign": { "type": "string" },
        "mmsi": { "type": "string" },
        "imo": { "type": "string" },
        "sanction_uid": { "type": "string" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "score": { "type": "number", "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": false
}
